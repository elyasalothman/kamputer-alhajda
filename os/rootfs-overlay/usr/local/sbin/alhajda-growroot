#!/bin/bash
# Grow the root partition + ext4 filesystem to fill the (possibly enlarged) virtual disk.
set -u
root=$(findmnt -no SOURCE /)
case "$root" in /dev/*) ;; *) exit 0;; esac
disk="/dev/$(lsblk -no PKNAME "$root" | head -n1)"
part=$(cat "/sys/class/block/$(basename "$root")/partition" 2>/dev/null || true)
[ -n "$part" ] && [ -b "$disk" ] || exit 0
sgdisk -e "$disk" >/dev/null 2>&1 || true      # move backup GPT header to the new end
partprobe "$disk" 2>/dev/null || true
if growpart "$disk" "$part"; then
  resize2fs "$root"
fi
exit 0
