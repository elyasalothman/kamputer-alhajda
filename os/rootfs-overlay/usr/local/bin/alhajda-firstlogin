#!/bin/bash
# First desktop login: put Alhajda shortcuts on the (localised) desktop, set wallpaper.
marker="${XDG_CONFIG_HOME:-$HOME/.config}/alhajda/firstlogin-done"
[ -e "$marker" ] && exit 0
sleep 5
xdg-user-dirs-update >/dev/null 2>&1 || true
desk=$(xdg-user-dir DESKTOP 2>/dev/null || echo "$HOME/Desktop")
mkdir -p "$desk"
for f in /usr/share/alhajda/desktop/*.desktop; do
  [ -e "$f" ] || continue
  dest="$desk/$(basename "$f")"
  cp -f "$f" "$dest"
  chmod +x "$dest"
  # mark launcher as trusted so XFCE does not ask
  gio set -t string "$dest" metadata::xfce-exe-checksum "$(sha256sum "$dest" | cut -d' ' -f1)" 2>/dev/null || true
  gio set "$dest" metadata::trusted true 2>/dev/null || true
done
WP=/usr/share/backgrounds/alhajda/alhajda-wallpaper.png
if command -v xfconf-query >/dev/null; then
  for p in $(xfconf-query -c xfce4-desktop -l 2>/dev/null | grep -E 'last-image$|image-path$'); do
    xfconf-query -c xfce4-desktop -p "$p" -s "$WP" 2>/dev/null || true
  done
fi
mkdir -p "$(dirname "$marker")" && touch "$marker"
